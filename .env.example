# xAI API key from https://console.x.ai
# NEVER commit the real .env file
XAI_API_KEY=your_key_here

# grok-imagine-image = jeftiniji | grok-imagine-image-2.0 = bolji try-on (preporučeno)
XAI_IMAGE_MODEL=grok-imagine-image-2.0

# Backend port
PORT=3001

# Firecrawl — glavni fallback za Zara / H&M (https://www.firecrawl.dev)
FIRECRAWL_API_KEY=fc-xxxxx

# Apify — rezervni fallback (opciono)
APIFY_API_TOKEN=apify_api_xxxxx
# APIFY_WAIT_SECS=180
